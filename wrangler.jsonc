// Cloudflare Worker: serves the game's files and the online rooms (server/relay.mjs). Deploy: npx wrangler deploy
{
  "name": "master-baiter",
  "main": "server/relay.mjs",
  "compatibility_date": "2025-09-01",
  // the game's files are copied to dist/ and served from there: serving the repo root made `wrangler dev`
  // restart (dropping every room) whenever anything in .git or .wrangler changed
  "build": { "command": "rm -rf dist && mkdir dist && cp -r index.html style.css js assets dist/", "watch_dir": ["js", "assets"] },
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
